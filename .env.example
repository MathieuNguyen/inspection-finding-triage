# Copy to .env and fill in. .env is gitignored; never commit it.
#   cp .env.example .env

# Read unprefixed, under the name the OpenAI SDK itself uses.
OPENAI_API_KEY=

# The flagship model for every pass.
TRIAGE_MODEL=gpt-5.6-luna

# Reasoning budget per kind of work.
#   writing  — extraction, summaries, recommended actions
#   judging  — scoring and review flags
# One of: minimal, low, medium, high, xhigh.
TRIAGE_WRITING_EFFORT=medium
TRIAGE_JUDGING_EFFORT=high

# How many findings are assessed at once.
TRIAGE_MAX_CONCURRENCY=6

# Seconds before a single request is abandoned.
TRIAGE_REQUEST_TIMEOUT=120

# Transport retries: 429s, 5xx and dropped connections, applied by the SDK.
TRIAGE_MAX_RETRIES=3

# Attempts at a usable answer, counting the first. A second attempt re-asks with
# the validation errors from the first. A separate budget from TRIAGE_MAX_RETRIES.
TRIAGE_MAX_OUTPUT_ATTEMPTS=2
